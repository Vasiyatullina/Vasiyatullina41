<Page x:Class="Vasiyatullina41.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Vasiyatullina41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage" FontFamily="Comic Sans MS" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
      
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10,10,10,10" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Вы авторизованы как "  VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Name="FIOTB"  VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                <TextBlock Text="Роль: " VerticalAlignment="Center"  HorizontalAlignment="Right" />
                <TextBlock Name="RoleTB" Text="Роль " VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,0"/>
            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,10,10,10" VerticalAlignment="Center">


                <TextBlock Name="CountTextBlock" Text="кол-во 0 из 0" VerticalAlignment="Center" Margin="0,0,15,0"/>

                <TextBlock Text="поиск по наименованию" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Name="SearchTextBox" Width="120" TextChanged="SearchTextBox_TextChanged" VerticalAlignment="Center" Margin="0,0,15,0"/>

                <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                    <RadioButton Name="SortAscRadioButton" Content="по возрастанию стоимости" Checked="SortRadioButton_Checked" FontSize="11"/>
                    <RadioButton Name="SortDescRadioButton" Content="по убыванию стоимости" Checked="SortRadioButton_Checked" FontSize="11"/>
                </StackPanel>

                <TextBlock Text="фильтрация по скидке" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Name="FilterComboBox" Width="130" SelectionChanged="FilterComboBox_SelectionChanged" VerticalAlignment="Center">
                    <ComboBoxItem Content="Все диапазоны" IsSelected="True"/>
                    <ComboBoxItem Content="0-9,99%"/>
                    <ComboBoxItem Content="10-14,99%"/>
                    <ComboBoxItem Content="15% и более"/>
                </ComboBox>
         </StackPanel>
        

        <ListView Grid.Row="2" Name="ProductListView" BorderThickness="0" Background="White">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="{TemplateBinding Background}" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,10,0,10">
                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Width="100" Height="100" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="ProductPhotoFull">
                                    <Binding.TargetNullValue>
                                        <ImageSource>/Resources/picture.png</ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                            <TextBlock Text="{Binding ProductName}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="{Binding ProductDescription}" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ProductManufacturer}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ProductCost, StringFormat={}{0:0} рублей}" FontSize="14" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <TextBlock Text="Скидка" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0} %}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>