<Window x:Class="Vasiyatullina41.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vasiyatullina41"
        mc:Ignorable="d"
            Title="Васиятуллина 41" Height="450" Width="800" FontFamily="Comic Sans MS" Icon="/Resources/icon.ico" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        
        <Image Source="Resources/logo.png" HorizontalAlignment="Left"></Image>

        <TextBlock Text="OOO 41 размер" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" ></TextBlock>

        <Button Name="BtnBack" Content="Назад" Click="BtnBack_Click" Width="100" Height="30" HorizontalAlignment="Right" Margin="10"></Button>

         <Frame Grid.Row="1" Name="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden" ></Frame>

    </Grid>
</Window>
