<Page x:Class="Vasiyatullina41.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Vasiyatullina41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" FontFamily="Comic Sans MS" FontSize="25">

    <Grid>
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Логин" HorizontalAlignment="Right"  VerticalAlignment="Center" ></TextBlock>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Пароль" HorizontalAlignment="Right" VerticalAlignment="Center" ></TextBlock>

            <TextBox Name="LoginTB" Grid.Row="0" Grid.Column="1" 
                 Width="250" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <TextBox Name="PassTB" Grid.Row="1" Grid.Column="1"  
     Width="250" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <Button Name="LoginGBtn" Click="LoginInGoustBtn_Click" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Войти как гость" Width="200" Height="30" />

            <Button Name="LoginBtn" Click="LoginInBtn_Click" Grid.Row="3"  Grid.Column="1" Content="Войти" Width="200" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <StackPanel Name="CaptchaPanel" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock Name="CaptchaText" FontSize="22" TextDecorations="Strikethrough" HorizontalAlignment="Center"/>

                <TextBox Name="CaptchaTB" Width="150" FontSize="22" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <TextBlock Name="ErrorTextBlock" Foreground="#CC6600"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </StackPanel>

            <!--
            <StackPanel Name="CaptchaPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"  >
                <StackPanel  Name="CaptchaTB" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Name="captchaOneWord" FontSize="22" />
                <TextBlock Name="captchaTwoWord" FontSize="22" Margin="10,0,0,0"/>
                <TextBlock Name="captchaThreeWord" FontSize="22" TextDecorations="Strikethrough" Margin="10,0,0,0"/>
                <TextBlock Name="captchaFourWord" FontSize="22" TextDecorations="Strikethrough" Margin="10,0,0,0"/>
            </StackPanel>

                <TextBox Name="CaptchaTextBox" Width="200" Margin="0,10,0,0" HorizontalAlignment="Center"/>

                <TextBlock Name="ErrorTextBlock" Foreground="Red" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"/>
                
  
            </StackPanel>
            -->


        </Grid>
 
    </Grid>
</Page>
